# Build output
dist/
terraform-provider-nodeping
sbom.json
# OpenTofu / Terraform state, plans, and variable files
#
# These patterns are deliberately broad: state and plan artifacts are excluded by
# name, by extension and by directory, because a single committed plan file can
# expose an entire estate.
#
# State and plan files contain resource attribute values in cleartext, including
# any credential a provider wrote to state. Never commit one, and never attach
# one to a ticket.

# Plans (binary and JSON forms)
plan.json
plan.tfplan
*.tfplan
*.tfplan.json
tfplan
tfplan*
*.plan.json

# State (including backups and lock metadata)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
terraform.tfstate.d/

# Variable files — routinely hold secrets
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.tftpl

# Working directories and CLI config
.terraform/
.terraform.lock.hcl
.terraformrc
terraform.rc
.tofurc
tofu.rc
crash.log
crash.*.log

# Override files (local-only by convention)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment
.env
.envrc

# OS
.DS_Store
Thumbs.db

# Coverage
coverage.out
coverage.html

# Vendor (if used)
vendor/

# Local agent instructions; not part of the published repository
CLAUDE.md

# SBOM written by the release workflow before GoReleaser. Ignored so the
# working tree stays clean, which GoReleaser requires.
sbom/
